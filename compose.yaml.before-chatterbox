# Defines all containers used by the Misa project.
services:

  # -------------------------------------------------------
  # Python / Flask application
  # -------------------------------------------------------
  misa:
    build:
      context: .
      dockerfile: Dockerfile

    container_name: misa-app

    ports:
      - "8000:8000"

    volumes:
      - type: bind
        source: .
        target: /app

    working_dir: /app

    command:
      - python
      - app.py

    environment:
      # Ollama connection used by Misa's chat.
      OLLAMA_URL: http://ollama:11434
      OLLAMA_MODEL: qwen3:1.7b

      # Local Qdrant vector database.
      QDRANT_URL: http://qdrant:6333
      QDRANT_HOST: qdrant
      QDRANT_PORT: "6333"

      # Document RAG configuration.
      RAG_EMBED_MODEL: embeddinggemma
      RAG_COLLECTION: misa_knowledge

      # Mem0 long-term personal memory configuration.
      MEM0_TELEMETRY: "false"
      MEM0_LLM_MODEL: qwen3:1.7b
      MEM0_EMBED_MODEL: embeddinggemma
      MEM0_COLLECTION: misa_personal_memories
      MEM0_USER_ID: sonu

      # Local English speech services.
      ENGLISH_STT_URL: http://english-stt:9002/inference
      ENGLISH_TTS_URL: http://english-tts:9004/synthesize

    depends_on:
      ollama:
        condition: service_healthy

      model-pull:
        condition: service_completed_successfully

      embedding-pull:
        condition: service_completed_successfully

      model-warmup:
        condition: service_completed_successfully

      qdrant:
        condition: service_started

      english-stt:
        condition: service_healthy

      english-tts:
        condition: service_healthy

    restart: unless-stopped


  # -------------------------------------------------------
  # English speech-to-text
  # -------------------------------------------------------
  english-stt:
    build:
      context: ./voice
      dockerfile: Dockerfile

    image: misa-whisper:cuda12.8
    container_name: misa-whisper-stt

    gpus: all

    environment:
      NVIDIA_VISIBLE_DEVICES: all
      NVIDIA_DRIVER_CAPABILITIES: compute,utility

    ports:
      - "127.0.0.1:9002:9002"

    volumes:
      - type: bind
        source: ./voice/models
        target: /models
        read_only: true

    healthcheck:
      test:
        - CMD-SHELL
        - "bash -c 'exec 3<>/dev/tcp/127.0.0.1/9002'"

      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 30s

    restart: unless-stopped


  # -------------------------------------------------------
  # English text-to-speech
  # -------------------------------------------------------
  english-tts:
    build:
      context: ./voice/kokoro
      dockerfile: Dockerfile

    image: misa-kokoro:cpu
    container_name: misa-kokoro-tts

    environment:
      KOKORO_VOICE: af_heart
      KOKORO_LANGUAGE_CODE: a
      HF_HOME: /cache/huggingface

    ports:
      - "127.0.0.1:9004:9004"

    volumes:
      - type: volume
        source: kokoro_cache
        target: /cache

    healthcheck:
      test:
        - CMD
        - python
        - -c
        - "import urllib.request; urllib.request.urlopen('http://localhost:9004/health', timeout=5)"

      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 120s

    restart: unless-stopped


  # -------------------------------------------------------
  # Ollama local AI server
  # -------------------------------------------------------
  ollama:
    image: ollama/ollama:latest
    container_name: misa-ollama

    gpus: all

    environment:
      NVIDIA_VISIBLE_DEVICES: all
      NVIDIA_DRIVER_CAPABILITIES: compute,utility
      OLLAMA_KEEP_ALIVE: 30m

    ports:
      - "11434:11434"

    volumes:
      - type: volume
        source: ollama_models
        target: /root/.ollama

    healthcheck:
      test:
        - CMD
        - ollama
        - list

      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

    restart: unless-stopped


  # -------------------------------------------------------
  # Downloads Misa's conversational model
  # -------------------------------------------------------
  model-pull:
    image: ollama/ollama:latest
    container_name: misa-model-pull

    environment:
      OLLAMA_HOST: http://ollama:11434

    command:
      - pull
      - qwen3:1.7b

    depends_on:
      ollama:
        condition: service_healthy

    restart: "no"


  # -------------------------------------------------------
  # Downloads the local RAG embedding model
  # -------------------------------------------------------
  embedding-pull:
    image: ollama/ollama:latest
    container_name: misa-embedding-pull

    environment:
      OLLAMA_HOST: http://ollama:11434

    command:
      - pull
      - embeddinggemma

    depends_on:
      ollama:
        condition: service_healthy

    restart: "no"


  # -------------------------------------------------------
  # Loads Qwen into GPU memory before Misa starts
  # -------------------------------------------------------
  model-warmup:
    image: ollama/ollama:latest
    container_name: misa-model-warmup

    environment:
      OLLAMA_HOST: http://ollama:11434

    command:
      - run
      - qwen3:1.7b
      - --think=false
      - "Reply only with: ready"

    depends_on:
      model-pull:
        condition: service_completed_successfully

    restart: "no"


  # -------------------------------------------------------
  # Qdrant local vector database
  # -------------------------------------------------------
  qdrant:
    image: qdrant/qdrant:latest
    container_name: misa-qdrant

    ports:
      - "127.0.0.1:6333:6333"

    volumes:
      - type: volume
        source: qdrant_data
        target: /qdrant/storage

    restart: unless-stopped


# ---------------------------------------------------------
# Persistent Docker volumes
# ---------------------------------------------------------
volumes:

  ollama_models:
    name: misa_ollama_models

  qdrant_data:
    name: misa_qdrant_data

  kokoro_cache:
    name: misa_kokoro_cache
